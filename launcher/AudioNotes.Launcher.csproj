<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AudioNotes</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\index.html" LogicalName="index.html" />
    <EmbeddedResource Include="..\styles.css" LogicalName="styles.css" />
    <EmbeddedResource Include="..\app.js" LogicalName="app.js" />
    <EmbeddedResource Include="..\README.md" LogicalName="README.md" />
    <EmbeddedResource Include="..\samples\**\*">
      <LogicalName>samples/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
